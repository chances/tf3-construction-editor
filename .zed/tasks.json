[
  {
    "label": "Launch App",
    "command": "deno",
    "args": ["task", "dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "allow_concurrent_runs": false,
    "save": "all"
  },
  {
    "label": "Test",
    "command": "deno",
    "args": ["task", "test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "never",
    "save": "all"
  },
  {
    "label": "Format Sources",
    "command": "deno",
    "args": ["task", "fmt"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "no_focus",
    "hide": "on_success",
    "save": "all"
  }
]
